CREATE VIEW IF NOT EXISTS "by_district" AS
SELECT SUM("families"), SUM("households"), SUM("population"), SUM("male"), SUM("female")
FROM "census"
GROUP BY "district";

CREATE VIEW IF NOT EXISTS "total" AS
SELECT SUM("families"), SUM("households"), SUM("population"), SUM("male"), SUM("female")
FROM "census";

CREATE VIEW IF NOT EXISTS "rural" AS
SELECT * FROM "census" WHERE "locality" LIKE "%Rural%";
