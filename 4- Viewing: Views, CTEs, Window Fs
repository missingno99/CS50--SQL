--CREATE VIEW to decode
CREATE VIEW "message" AS
--CTE: prepare data from cipher
WITH "prep" AS
(
    SELECT
        "triplet",
        MAX(CASE WHEN "tprow" = 1 THEN "number" END) AS "sentence_id",
        MAX(CASE WHEN "tprow" = 2 THEN "number" END) AS "start",
        MAX(CASE WHEN "tprow" = 3 THEN "number" END) AS "length"
    FROM
    (
        SELECT
            "triplet",
            "number",
            ROW_NUMBER() OVER
            (PARTITION BY "triplet"
            ORDER BY "triplet") AS "tprow"
        FROM "cipher"
    )
    GROUP BY "triplet"
)
--Complete view: use prepared data & decode
SELECT
    SUBSTR("sentences"."sentence", "start", "length") AS "phrase"
FROM "prep"
JOIN "sentences"
    ON "sentences"."id" = "sentence_id";





